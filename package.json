{
  "name": "carelink-companion",
  "version": "1.2.0",
  "description": "Windows helper that signs in to Medtronic CareLink and provides login data for the CGM Reader Homey app.",
  "private": true,
  "bin": "tools/carelink-companion.js",
  "scripts": {
    "carelink:login": "node tools/carelink-token-generator.js",
    "carelink:tool": "node tools/carelink-tool-server.js",
    "carelink:companion": "node tools/carelink-companion.js",
    "build:carelink-companion": "pkg . --targets node18-win-x64 --output dist/carelink-companion-win-x64.exe",
    "build:portable": "powershell -NoProfile -ExecutionPolicy Bypass -File tools\\build-portable.ps1"
  },
  "pkg": {
    "assets": [
      "node_modules/playwright/**/*",
      "node_modules/playwright-core/**/*",
      "node_modules/axios/dist/**",
      "node_modules/axios/dist/node/**",
      "node_modules/qs/**",
      "node_modules/node-forge/**"
    ]
  },
  "dependencies": {
    "abort-controller": "^3.0.0",
    "axios": "^1.13.6",
    "node-fetch": "^2.7.0",
    "node-forge": "^1.3.3",
    "playwright": "^1.58.2",
    "qs": "^6.15.0"
  },
  "devDependencies": {
    "pkg": "^5.8.1"
  }
}
